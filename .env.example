# Copy to .env on each machine and fill in real secrets.

# ---- InfluxDB ----
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me
INFLUXDB_ORG=casa
INFLUXDB_BUCKET_HISTORY=history
INFLUXDB_BUCKET_LIVE=live
INFLUXDB_RETENTION_HISTORY=31d
INFLUXDB_RETENTION_LIVE=48h
INFLUXDB_TOKEN=change-me-long-random-token

# ---- Collector (Modbus -> InfluxDB) ----
INVERTER_DEVICE=/dev/growatt
MODBUS_BAUD=9600
MODBUS_SLAVE=1
POLL_INTERVAL_LIVE=1
HISTORY_INTERVAL=60

# REG_COUNT >= 89 (highest register read is 88 = energy_load_total, regs 87/88); 91 keeps margin.
# Battery power/currents come from Bat_Watt regs 77/78 + charge/discharge currents regs 83/84.
REG_COUNT=91
DEBUG_RAW=0

# ---- Alerts (ntfy) ----
NTFY_TOPIC=Alerta_6Kw
NTFY_URL=http://ntfy/Alerta_6Kw
ALERT_THRESHOLD_W=5500
ALERT_CLEAR_W=5000
ALERT_COOLDOWN_S=300
ALERT_DEBOUNCE_S=3

# ---- Battery / output / temperature alert thresholds ----
BAT_LOW_V=48.0
BAT_LOW_V_CLR=49.0
BAT_HIGH_V=57.5
BAT_HIGH_V_CLR=56.0
TEMP_HIGH=65
TEMP_HIGH_CLR=60
OUT_LOST_V=180
OUT_LOST_V_CLR=200
GRID_PRESENT_V=100
BATTERY_FIRST_MIN_V=48.0
INVERTER_LOSS_ESTIMATE_W=90
# Mediana glisanta (s) pe bilantul de puteri (inverter_loss, power_deficit, grid_import_power,
# descarcarea inferata a bateriei); 0 = fara filtrare
BALANCE_SMOOTH_S=60
# Sursa casei (PV/baterie/retea) se schimba doar daca noua sursa tine N secunde; 0 = imediat
HOUSE_SOURCE_HOLD_S=10

# ---- Scrieri InfluxDB (optional) ----
# Daca InfluxDB nu raspunde, punctele asteapta in memorie si se trimit cand revine.
INFLUX_TIMEOUT_MS=3000
INFLUX_RETRY_S=10
INFLUX_BUFFER_LIVE=900
INFLUX_BUFFER_HISTORY=1440

# ---- Watchdog ----
WATCHDOG_FAILS=30

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ---- Baterie JK BMS (serviciul solar-bms, pe host; Bluetooth LE, doar citire) ----
# Adresa o gasesti cu: python3 -I -c "import asyncio;from bleak import BleakScanner as S;print(asyncio.run(S.discover(10)))"
BMS_ADDRESS=AA:BB:CC:DD:EE:FF
# Praguri alerte BMS (valorile implicite; decomenteaza ca sa le schimbi, apoi: systemctl restart solar-bms).
# Push ntfy pe NTFY_TOPIC si alarma din aplicatie (via /solar/bms). Fiecare prag are o valoare de revenire.
# BMS_CELL_HIGH_V=4.12        # celula maxima, V          (revenire BMS_CELL_HIGH_V_CLR=4.08)
# BMS_CELL_LOW_V=3.20         # celula minima, V          (revenire BMS_CELL_LOW_V_CLR=3.30)
# BMS_DELTA_HIGH_V=0.100      # diferenta intre celule, V (revenire BMS_DELTA_HIGH_V_CLR=0.060)
# BMS_TEMP_HIGH=45            # T1/T2 baterie, C          (revenire BMS_TEMP_HIGH_CLR=40)
# BMS_MOS_TEMP_HIGH=80        # MOSFET-urile BMS, C       (revenire BMS_MOS_TEMP_HIGH_CLR=70)
# BMS_TEMP_LOW=2              # baterie prea rece, C      (revenire BMS_TEMP_LOW_CLR=5)
# BMS_LINK_LOST_S=180         # fara date de la BMS, secunde
