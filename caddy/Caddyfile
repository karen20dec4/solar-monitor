# Reverse proxy HTTPS pentru acces remote la Grafana.
# Lant: https://vyra.go.ro:31443 -> ZTE 31443 -> .210:443 -> TP-Link 443 -> caddy:443 -> grafana:3000
#
# Nu putem folosi Let's Encrypt (portul public e non-standard 31443, ACME are nevoie de 80/443
# publice standard). Deci folosim "tls internal" = certificat self-signed semnat de CA-ul intern
# Caddy. Browserul va da un avertisment prima data; il accepti (sau instalezi root CA pe telefon
# ca sa dispara - vezi /data/caddy/pki/authorities/local/root.crt in volumul caddy-data).
{
	# fara redirect automat 80->443 (portul 80 nu e expus oricum)
	auto_https disable_redirects
}

vyra.go.ro {
	tls internal
	# CASA: prize si senzori Tuya (serviciul solar-casa). Autentificarea o face serviciul (token per telefon).
	# X-Forwarded-For primeste o singura intrare, IP-ul real al clientului (folosit la limita de incercari de parola).
	handle_path /solar/casa/* {
		# Cererile fara autentificare nu pot tine firele serviciului: corp mic, timeouturi scurte.
		request_body {
			max_size 16KB
		}
		# Cel mai rau caz al unei comenzi la serviciu = 5 s coada pe priza + 10 s lock controller + 10 s comanda
		# = 25 s (web.py PLUG_BUSY_WAIT_S, controller.py CMD_TIMEOUT_S): sub read_timeout 45 s, ca telefonul sa
		# primeasca JSON-ul 502/503, nu un 502 gol de la Caddy. Aplicatia Android: timeout de citire >= 35 s.
		# request_buffers: Caddy citeste tot corpul (max 16KB) inainte sa-l dea serviciului, deci un client
		# lent nu tine un fir gunicorn.
		reverse_proxy casa:8100 {
			header_up X-Forwarded-For {remote_host}
			request_buffers 16KB
			transport http {
				read_timeout 45s
				write_timeout 45s
			}
		}
	}
	# API JSON pentru aplicatia mobila: /solar/* -> microserviciu (strip prefix /solar).
	handle_path /solar/* {
		reverse_proxy api:8000
	}
	# restul traficului -> Grafana
	handle {
		reverse_proxy grafana:3000
	}
}

# Aplicatia de subtitrari (mp4-to-srt, proiect separat in /01-Proiecte/1.mp4-to-srt/webapp).
# Lant: https://vyra.go.ro:31480 -> ZTE 31480 -> .210:8443 -> TP-Link 8443 -> caddy:8443 -> Beci:8090
# Proxy catre portul publicat pe host (containerul mp4-to-srt e in alta retea Docker).
# Aplicatia are Basic Auth propriu (APP_PASSWORD in webapp/.env) - obligatoriu setat.
vyra.go.ro:8443 {
	tls internal
	reverse_proxy 192.168.1.199:8090
}
